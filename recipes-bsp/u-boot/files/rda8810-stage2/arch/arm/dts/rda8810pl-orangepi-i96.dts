/dts-v1/;

#include "rda8810pl.dtsi"

/ {
	compatible = "xunlong,orangepi-i96", "rda,8810pl";
	model = "Orange Pi i96";

	aliases {
		serial0 = &uart2;
		serial1 = &uart1;
		serial2 = &uart3;
	};

	chosen {
		stdout-path = "serial2:921600n8";
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x10000000>;
	};

	uart_clk: uart-clk {
		compatible = "fixed-clock";
		clock-frequency = <921600>;
		#clock-cells = <0>;
	};
};

/* Bus 0: the RDA599x WiFi/BT combo control interface. u-boot only ever talks to
 * wifi_rf@14 (the chip id lives there); the other three are listed so a plain
 * "i2c probe" shows the whole combo. */
&i2c1 {
	status = "okay";

	wifi_core: wifi@13 {
		compatible = "rda,wifi-core-i2c";
		reg = <0x13>;
	};

	wifi_rf: wifi@14 {
		compatible = "rda,wifi-rf-i2c";
		reg = <0x14>;
	};

	bt_core: bluetooth@15 {
		compatible = "rda,bt-core-i2c";
		reg = <0x15>;
	};

	bt_rf: bluetooth@16 {
		compatible = "rda,bt-rf-i2c";
		reg = <0x16>;
	};
};

&uart1 {
	status = "okay";
	clocks = <&uart_clk>;
};

&uart2 {
	status = "okay";
	clocks = <&uart_clk>;
};

&uart3 {
	status = "okay";
	clocks = <&uart_clk>;
};
