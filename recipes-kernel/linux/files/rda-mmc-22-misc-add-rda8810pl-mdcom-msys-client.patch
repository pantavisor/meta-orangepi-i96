+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * rda-mdsys.h - AP-side msys command client for the RDA8810PL modem
+ *
+ * The RDA8810PL baseband coprocessor ("modem", xcpu) owns the PMU rails
+ * and the low-frequency clock gates of the SoC. The AP requests them
+ * over the mdcom mailbox with framed "msys" commands. The command and
+ * module ids below are verbatim from the vendor 3.10 tree
+ * (arch/arm/plat-rda/include/plat/md_sys.h).
+ */
+
+#ifndef __LINUX_RDA_MDSYS_H__
+#define __LINUX_RDA_MDSYS_H__
+
+#include <linux/errno.h>
+#include <linux/types.h>
+
+/* Modules */
+#define RDA_MDSYS_GEN_MOD		0x0
+#define RDA_MDSYS_PM_MOD		0x2
+
+/* General module commands */
+#define RDA_MDSYS_GEN_CMD_CLK_OUT	0x1004	/* 0=off, 1=32k, 2=26M */
+#define RDA_MDSYS_GEN_CMD_AUX_CLK	0x1005	/* 0=off, 1=26M */
+#define RDA_MDSYS_GEN_CMD_BP_INFO	0x1007
+
+/* Power module commands */
+#define RDA_MDSYS_PM_CMD_EN		0x1001	/* {pm_id, 0|1} */
+
+/* PM ids (vendor arch/arm/mach-rda/regulator-devices.c) */
+#define RDA_MDSYS_PM_ID_BT		10	/* v_bt: RDA5991 combo supply */
+#define RDA_MDSYS_PM_ID_CAM_FLASH	11
+#define RDA_MDSYS_PM_ID_LCD		12
+
+#if IS_ENABLED(CONFIG_RDA_MDSYS)
+
+/* True once the probe handshake with the modem firmware has succeeded. */
+bool rda_mdsys_running(void);
+
+/*
+ * Send one synchronous msys command and wait for the modem's reply.
+ * @data/@len: parameter block (len must be a multiple of 4, may be 0).
+ * @out/@out_cap: optional buffer for reply parameters.
+ * Returns 0 on success (modem replied with status 0), -ENODEV when the
+ * modem is not running, -ETIMEDOUT / -EIO otherwise.
+ */
+int rda_mdsys_cmd(u16 mod_id, u16 msg_id, const void *data, int len,
+		  void *out, int out_cap);
+
+int rda_mdsys_pm_enable(u32 pm_id, bool on);
+int rda_mdsys_aux_clk(bool on);
+int rda_mdsys_clk_out(u32 mode);
+
+#else /* !CONFIG_RDA_MDSYS */
+
+static inline bool rda_mdsys_running(void)
+{
+	return false;
+}
+
+static inline int rda_mdsys_cmd(u16 mod_id, u16 msg_id, const void *data,
+				int len, void *out, int out_cap)
+{
+	return -ENODEV;
+}
+
+static inline int rda_mdsys_pm_enable(u32 pm_id, bool on)
+{
+	return -ENODEV;
+}
+
+static inline int rda_mdsys_aux_clk(bool on)
+{
+	return -ENODEV;
+}
+
+static inline int rda_mdsys_clk_out(u32 mode)
+{
+	return -ENODEV;
+}
+
+#endif /* CONFIG_RDA_MDSYS */
+
+#endif /* __LINUX_RDA_MDSYS_H__ */
