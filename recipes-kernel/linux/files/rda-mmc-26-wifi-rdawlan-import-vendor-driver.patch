+static void cfgp2p_ethtool_get_drvinfo(struct net_device *net,
+	struct ethtool_drvinfo *info)
+{
+	snprintf(info->driver, sizeof(info->driver), "p2p");
+	snprintf(info->version, sizeof(info->version), "%lu", (ulong) (0));
+}
