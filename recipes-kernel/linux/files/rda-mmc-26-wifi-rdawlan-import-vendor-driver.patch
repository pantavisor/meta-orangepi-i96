+	clear_bit(VIF_STATUS_AP_CREATING, &ifp->vif->sme_state);
+	set_bit(VIF_STATUS_AP_CREATED, &ifp->vif->sme_state);
+
+exit:
+	WLAND_DBG(CFG80211, TRACE, "Done(err:%d)\n", err);
+
+	return err;
+}
