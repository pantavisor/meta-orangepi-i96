+
+	WLAND_DBG(CFG80211, TRACE, "Applied Vndr IEs for Beacon\n");
+
+	/*
+	 * Set Probe Response IEs to FW
+	 */
+	err = wland_vif_set_mgmt_ie(ifp->vif, WLAND_VNDR_IE_PRBRSP_FLAG,
