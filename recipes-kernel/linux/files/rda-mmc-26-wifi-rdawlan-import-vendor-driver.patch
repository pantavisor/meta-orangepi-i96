+	/*
+	 * set authtype
+	 */
+	if (priv->secinfo.auth_mode & IW_AUTH_ALG_OPEN_SYSTEM
+		|| priv->secinfo.auth_mode & IW_AUTH_ALG_SHARED_KEY) {
+		if (priv->secinfo.auth_mode & IW_AUTH_ALG_OPEN_SYSTEM) {
