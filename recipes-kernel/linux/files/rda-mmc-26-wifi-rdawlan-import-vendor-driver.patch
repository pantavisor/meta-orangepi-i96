+static s32 cfg80211_config_default_mgmt_key(struct wiphy *wiphy,
+	struct net_device *ndev, u8 key_idx)
+{
+	WLAND_DBG(CFG80211, TRACE, "Not supported\n");
+
+	return -EOPNOTSUPP;
+}
