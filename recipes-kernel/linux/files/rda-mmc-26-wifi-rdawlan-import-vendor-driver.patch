+	while ((ie = wland_parse_tlvs(parse, len, WLAN_EID_VENDOR_SPECIFIC))) {
+		if (wland_tlv_has_ie((u8 *) ie, &parse, &len, WPA_OUI,
+				TLV_OUI_LEN, WPS_OUI_TYPE))
+			return (struct wland_vs_tlv *) ie;
+	}
+	return NULL;
+}
