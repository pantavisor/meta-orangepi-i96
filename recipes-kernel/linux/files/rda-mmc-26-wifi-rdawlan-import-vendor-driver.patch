+static void wland_pkt_word_align(struct sk_buff *p)
+{
+	uint datalign = ALIGNMENT;
+	uint offset = ((unsigned long) (p->data) & (datalign - 1));
+
+	if (offset) {
+		skb_reserve(p, (datalign - offset));
+	}
+}
