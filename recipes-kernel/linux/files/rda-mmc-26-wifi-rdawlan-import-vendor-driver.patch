+	u8      AMP_status;
+	u32  	bandwidth;
+	u32  	gbandwidth;
+	u32  	latency;
+	u32  	PDU_size;
+	u8      ctrl_type;
+	u16     PAL_cap;
+	u16     AMP_ASSOC_len;
+	u32  	max_flush_timeout;
+	u32  	be_flush_timeout;
+} POST_PACKED read_local_info_evt_parms_t;
+
+typedef PRE_PACKED struct log_link_evt_parms {
+	u8  status;
