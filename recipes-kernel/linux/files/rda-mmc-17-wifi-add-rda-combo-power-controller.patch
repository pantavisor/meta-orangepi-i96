diff --git a/drivers/net/wireless/rdaw80211/rdacombodev/rda_combo_power_main.c b/drivers/net/wireless/rdaw80211/rdacombodev/rda_combo_power_main.c
new file mode 100644
--- /dev/null
+++ b/drivers/net/wireless/rdaw80211/rdacombodev/rda_combo_power_main.c
@@ -0,0 +1,374 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * RDA599x WiFi/BT combo chip power controller — modern forward-port.
+ *
+ * Lean DT-based rewrite of the vendor 3.10 rda_combo_power_main.c
+ * (OrangePiLibra/OrangePi_i96_kernel). The chip exposes four I2C control
+ * clients (wifi core 0x13, wifi rf 0x14, bt core 0x15, bt rf 0x16); the
+ * per-chip power sequences (rda_599x_power_ctrl.c) are kept verbatim from
+ * the vendor tree and drive those clients through the helpers here.
+ *
+ * The vendor 26 MHz / 32 kHz clock and LDO management went through the
+ * modem-side PMU, which mainline cannot reach yet; those helpers are
+ * no-ops here on the assumption the modem firmware keeps the shared
+ * clocks/LDO up (bench-verify via the chip version read at probe).
+ *
+ * Copyright RDA Microelectronics Company Limited
+ */
+
+#include <linux/atomic.h>
+#include <linux/completion.h>
+#include <linux/delay.h>
+#include <linux/i2c.h>
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+
+#include "rda_combo.h"
+
+struct i2c_client *rda_wifi_core_client;
+struct i2c_client *rda_wifi_rf_client;
+struct i2c_client *rda_bt_core_client;
+struct i2c_client *rda_bt_rf_client;
+struct completion rda_wifi_bt_comp;
+atomic_t wifi_fw_status = ATOMIC_INIT(0);
+atomic_t bt_fw_status = ATOMIC_INIT(0);
+
+static DEFINE_MUTEX(rda_combo_i2c_mutex);
+static unsigned short wlan_version;
+static const bool isBigEnded;	/* AP is little-endian */
+
+void rda_combo_i2c_lock(void)
+{
+	mutex_lock(&rda_combo_i2c_mutex);
+}
+EXPORT_SYMBOL(rda_combo_i2c_lock);
+
+void rda_combo_i2c_unlock(void)
+{
+	mutex_unlock(&rda_combo_i2c_mutex);
+}
+EXPORT_SYMBOL(rda_combo_i2c_unlock);
+
+/* Vendor PMU-backed clock/regulator management — no-ops for now (see top). */
+void enable_26m_regulator(u8 mask) { }
+void disable_26m_regulator(u8 mask) { }
+void enable_26m_rtc(u8 mask) { }
+void disable_26m_rtc(u8 mask) { }
+void enable_32k_rtc(u8 mask) { }
+void disable_32k_rtc(u8 mask) { }
+
+int i2c_write_1_addr_2_data(struct i2c_client *client, const u8 addr,
+			    const u16 data)
+{
+	unsigned char buf[3];
+	int retry = 3, ret = 0;
+
+	if (!isBigEnded) {
+		buf[0] = addr;
+		buf[1] = data >> 8;
+		buf[2] = data >> 0;
+	} else {
+		buf[0] = addr;
+		buf[1] = data >> 0;
+		buf[2] = data >> 8;
+	}
+
+	while (retry--) {
+		ret = i2c_master_send(client, buf, 3);
+		if (ret >= 0)
+			break;
+	}
+	if (ret < 0) {
+		dev_err(&client->dev, "i2c write reg 0x%x failed: %d\n", addr,
+			ret);
+		return -1;
+	}
+	return 0;
+}
+EXPORT_SYMBOL(i2c_write_1_addr_2_data);
+
+int i2c_read_1_addr_2_data(struct i2c_client *client, const u8 addr, u16 *data)
+{
+	unsigned char buf[2];
+	int retry = 3, ret = 0;
+
+	while (retry--) {
+		ret = i2c_master_send(client, &addr, 1);
+		if (ret >= 0)
+			break;
+	}
+	if (ret < 0) {
+		dev_err(&client->dev, "i2c read (addr phase) 0x%x failed: %d\n",
+			addr, ret);
+		return -1;
+	}
+
+	retry = 3;
+	while (retry--) {
+		ret = i2c_master_recv(client, buf, 2);
+		if (ret >= 0)
+			break;
+	}
+	if (ret < 0) {
+		dev_err(&client->dev, "i2c read (data phase) 0x%x failed: %d\n",
+			addr, ret);
+		return -1;
+	}
+
+	if (!isBigEnded)
+		*data = (buf[0] << 8) | buf[1];
+	else
+		*data = (buf[1] << 8) | buf[0];
+	return 0;
+}
+EXPORT_SYMBOL(i2c_read_1_addr_2_data);
+
+int rda_i2c_write_data_to_rf(struct i2c_client *client, const u16 (*data)[2],
+			     u32 count)
+{
+	u32 i;
+	int ret = 0;
+
+	for (i = 0; i < count; i++) {
+		if (data[i][0] == I2C_DELAY_FLAG) {
+			msleep(data[i][1]);
+			continue;
+		}
+		ret = i2c_write_1_addr_2_data(client, data[i][0], data[i][1]);
+		if (ret < 0)
+			break;
+	}
+	return ret;
+}
+EXPORT_SYMBOL(rda_i2c_write_data_to_rf);
+
+static void wlan_read_version_from_chip(void)
+{
+	int ret;
+	u16 project_id = 0, chip_version = 0;
+
+	if (wlan_version != 0 || !rda_wifi_rf_client)
+		return;
+
+	ret = i2c_write_1_addr_2_data(rda_wifi_rf_client, 0x3f, 0x0001);
+	if (ret)
+		goto out;
+	ret = i2c_read_1_addr_2_data(rda_wifi_rf_client, 0x21, &chip_version);
+	if (ret)
+		goto out;
+	ret = i2c_read_1_addr_2_data(rda_wifi_rf_client, 0x20, &project_id);
+	if (ret)
+		goto out;
+
+	if (project_id == 0x5990) {
+		if (chip_version == 0x47)
+			wlan_version = WLAN_VERSION_90_D;
+		else if (chip_version == 0x44 || chip_version == 0x45)
+			wlan_version = WLAN_VERSION_90_E;
+	} else if (project_id == 0x5991) {
+		if (chip_version == 0x44)
+			wlan_version = WLAN_VERSION_91;
+		else if (chip_version == 0x45)
+			wlan_version = WLAN_VERSION_91_E;
+		else if (chip_version == 0x46)
+			wlan_version = WLAN_VERSION_91_F;
+		else if (chip_version == 0x47)
+			wlan_version = WLAN_VERSION_91_G;
+	}
+
+	if (wlan_version == 0)
+		pr_err("rda_combo: unsupported chip: project 0x%x version 0x%x\n",
+		       project_id, chip_version);
+	else
+		pr_info("rda_combo: RDA%x chip version 0x%x (wlan_version %u)\n",
+			project_id, chip_version, wlan_version);
+out:
+	i2c_write_1_addr_2_data(rda_wifi_rf_client, 0x3f, 0x0000);
+}
+
+u32 rda_wlan_version(void)
+{
+	if (wlan_version == 0)
+		wlan_read_version_from_chip();
+	return wlan_version;
+}
+EXPORT_SYMBOL(rda_wlan_version);
+
+int check_test_mode(void)
+{
+	return 0;
+}
+EXPORT_SYMBOL(check_test_mode);
+
+int check_role_mode(void)
+{
+	return 0;	/* station mode */
+}
+EXPORT_SYMBOL(check_role_mode);
+
+void rda_combo_set_wake_lock(void)
+{
+	/* Android wakelocks are gone; pantavisor systems don't autosuspend. */
+}
+EXPORT_SYMBOL(rda_combo_set_wake_lock);
+
+int rda_wifi_power_on(void)
+{
+	switch (rda_wlan_version()) {
+	case WLAN_VERSION_90_D:
+	case WLAN_VERSION_90_E:
+		return rda_5990_wifi_power_on();
+	case WLAN_VERSION_91:
+		return rda_5991_wifi_power_on();
+	case WLAN_VERSION_91_E:
+		return rda_5991e_wifi_power_on();
+	case WLAN_VERSION_91_F:
+		return rda_5991f_wifi_power_on();
+	case WLAN_VERSION_91_G:
+		return rda_5991g_wifi_power_on();
+	}
+	return -ENODEV;
+}
+EXPORT_SYMBOL(rda_wifi_power_on);
+
+int rda_wifi_power_off(void)
+{
+	switch (rda_wlan_version()) {
+	case WLAN_VERSION_90_D:
+	case WLAN_VERSION_90_E:
+		return rda_5990_wifi_power_off();
+	case WLAN_VERSION_91:
+		return rda_5991_wifi_power_off();
+	case WLAN_VERSION_91_E:
+		return rda_5991e_wifi_power_off();
+	case WLAN_VERSION_91_F:
+		return rda_5991f_wifi_power_off();
+	case WLAN_VERSION_91_G:
+		return rda_5991g_wifi_power_off();
+	}
+	return -ENODEV;
+}
+EXPORT_SYMBOL(rda_wifi_power_off);
+
+int rda_bt_power_on(void)
+{
+	switch (rda_wlan_version()) {
+	case WLAN_VERSION_90_D:
+	case WLAN_VERSION_90_E:
+		return rda_5990_bt_power_on();
+	case WLAN_VERSION_91:
+		return rda_5991_bt_power_on();
+	case WLAN_VERSION_91_E:
+		return rda_5991e_bt_power_on();
+	case WLAN_VERSION_91_F:
+		return rda_5991f_bt_power_on();
+	case WLAN_VERSION_91_G:
+		return rda_5991g_bt_power_on();
+	}
+	return -ENODEV;
+}
+EXPORT_SYMBOL(rda_bt_power_on);
+
+int rda_bt_power_off(void)
+{
+	switch (rda_wlan_version()) {
+	case WLAN_VERSION_90_D:
+	case WLAN_VERSION_90_E:
+		return rda_5990_bt_power_off();
+	case WLAN_VERSION_91:
+		return rda_5991_bt_power_off();
+	case WLAN_VERSION_91_E:
+		return rda_5991e_bt_power_off();
+	case WLAN_VERSION_91_F:
+		return rda_5991f_bt_power_off();
+	case WLAN_VERSION_91_G:
+		return rda_5991g_bt_power_off();
+	}
+	return -ENODEV;
+}
+EXPORT_SYMBOL(rda_bt_power_off);
+
+/* ---- the four I2C control clients, instantiated from DT ---- */
+
+static void rda_combo_clients_ready(struct device *dev)
+{
+	u32 version;
+
+	if (!rda_wifi_core_client || !rda_wifi_rf_client ||
+	    !rda_bt_core_client || !rda_bt_rf_client)
+		return;
+
+	version = rda_wlan_version();
+	if (!version) {
+		dev_warn(dev,
+			 "combo chip did not answer version read (LDO/26M off?)\n");
+		return;
+	}
+
+	/*
+	 * Bring-up aid: power the WLAN side on right away so the SDIO
+	 * function enumerates. TODO: move under rfkill / the wlan driver's
+	 * control once rdawlan is ported.
+	 */
+	if (rda_wifi_power_on())
+		dev_warn(dev, "wifi power on failed\n");
+	else
+		dev_info(dev, "wifi powered on\n");
+}
+
+static int rda_combo_client_probe(struct i2c_client *client)
+{
+	const char *role = of_device_get_match_data(&client->dev) ?: "unknown";
+
+	if (!strcmp(role, "wifi-core"))
+		rda_wifi_core_client = client;
+	else if (!strcmp(role, "wifi-rf"))
+		rda_wifi_rf_client = client;
+	else if (!strcmp(role, "bt-core"))
+		rda_bt_core_client = client;
+	else if (!strcmp(role, "bt-rf"))
+		rda_bt_rf_client = client;
+	else
+		return -ENODEV;
+
+	dev_dbg(&client->dev, "rda combo %s client at 0x%02x\n", role,
+		client->addr);
+	rda_combo_clients_ready(&client->dev);
+	return 0;
+}
+
+static const struct of_device_id rda_combo_dt_ids[] = {
+	{ .compatible = "rda,wifi-core-i2c", .data = "wifi-core" },
+	{ .compatible = "rda,wifi-rf-i2c", .data = "wifi-rf" },
+	{ .compatible = "rda,bt-core-i2c", .data = "bt-core" },
+	{ .compatible = "rda,bt-rf-i2c", .data = "bt-rf" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, rda_combo_dt_ids);
+
+static struct i2c_driver rda_combo_driver = {
+	.probe = rda_combo_client_probe,
+	.driver = {
+		.name = "rda_combo",
+		.of_match_table = rda_combo_dt_ids,
+	},
+};
+
+static int __init rda_combo_init(void)
+{
+	init_completion(&rda_wifi_bt_comp);
+	complete(&rda_wifi_bt_comp);
+	return i2c_add_driver(&rda_combo_driver);
+}
+module_init(rda_combo_init);
+
+static void __exit rda_combo_exit(void)
+{
+	i2c_del_driver(&rda_combo_driver);
+}
+module_exit(rda_combo_exit);
+
+MODULE_DESCRIPTION("RDA599x WiFi/BT combo power controller");
+MODULE_LICENSE("GPL");
