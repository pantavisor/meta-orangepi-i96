+		goto err;
+
+	rda_combo_i2c_unlock();
+
+	printk(KERN_INFO "***rda_wifi_rf_dc_calsuccceed \n");
+	msleep(50);   //50ms delay
+	return 0;
+
+err:
+	rda_combo_i2c_unlock();
+
+	printk(KERN_INFO "***rda_wifi_rf_dc_calf_failed! \n");
+	return -1;
+}
