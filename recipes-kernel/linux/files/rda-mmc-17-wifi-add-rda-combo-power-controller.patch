+
+	ret = i2c_read_1_addr_2_data(rda_bt_rf_client, 0x28, &temp_data);
+	if (ret)
+		goto err;
+
+	ret = i2c_write_1_addr_2_data(rda_bt_rf_client, 0x3f, 0x0000);
+	if (temp_data & 0x8000)
+		return 1;
