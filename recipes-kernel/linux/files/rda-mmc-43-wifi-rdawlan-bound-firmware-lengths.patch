From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Sergio Marin <sergio.marin@pantacor.com>
Date: Fri, 2 Oct 2026 04:14:43 -0300
Subject: [PATCH] wifi: rdawlan: bound firmware lengths, fix a start-failure
 use-after-free

From a memory-safety review of the vendor driver; lengths and pointers
that came from the firmware, a corrupted SDIO read or userspace were
trusted:

- A config frame shorter than its 2-byte header made the event length
  wrap to ~4 GB (u32), and the event copy overran the heap. Frames
  without a message type are dropped.
- A WID response longer than rxbuf (maxctl + 4) was copied into it whole,
  up to 472 bytes past the end. It is dropped instead.
- Scan results trusted their own WID length: 0 made the frame length wrap
  to 65535, so the IE copy read ~64 KB past a 2 KB event and handed that
  heap memory to userspace as the AP's IEs. The result must fit the event
  and hold a full frame header.
- When starting the chip failed, the fws interface was dropped after
  unregister_netdev had freed it with its netdev. It is dropped first.
- A connect naming only an SSID (no BSSID, no channel, no IEs) dereferenced
  all three under the RTNL and wiphy locks, which then stayed held.

Upstream-Status: Inappropriate [vendor driver, not upstream]
---
 .../wireless/rdaw80211/rdawlan/wland_bus.c    | 12 ++++-
 .../rdaw80211/rdawlan/wland_cfg80211.c        | 49 ++++++++++++++-----
 .../wireless/rdaw80211/rdawlan/wland_cmds.c   |  7 +++
 .../wireless/rdaw80211/rdawlan/wland_sdio.c   | 22 +++++++++
 4 files changed, 78 insertions(+), 12 deletions(-)

diff --git a/drivers/net/wireless/rdaw80211/rdawlan/wland_bus.c b/drivers/net/wireless/rdaw80211/rdawlan/wland_bus.c
index daf8f20..3011161 100644
--- a/drivers/net/wireless/rdaw80211/rdawlan/wland_bus.c
+++ b/drivers/net/wireless/rdaw80211/rdawlan/wland_bus.c
@@ -271,9 +271,18 @@ netdev_p2p_attach_fail:
 #endif /* WLAND_P2P_SUPPORT */
 
 	if (ret<0 && ifp && ifp->ndev) {
+		/*
+		 * ifp lives in the netdev's private area, and unregistering the
+		 * netdev frees it (priv_destructor = free_netdev): drop the fws
+		 * interface first, and do not touch ifp afterwards. It used to be
+		 * passed to wland_fws_del_interface() below, after the free.
+		 */
+		if (drvr->fws)
+			wland_fws_del_interface(ifp);
 		WLAND_ERR("unregister netdev.\n");
 		unregister_netdev(ifp->ndev);
 		drvr->iflist[0] = NULL;
+		ifp = NULL;
 	}
 
 out:
@@ -286,7 +295,8 @@ out:
 
 		if (drvr->fws) {
 			WLAND_ERR("wland_fws_deinit\n");
-			wland_fws_del_interface(ifp);
+			if (ifp)
+				wland_fws_del_interface(ifp);
 			wland_fws_deinit(drvr);
 		}
 
diff --git a/drivers/net/wireless/rdaw80211/rdawlan/wland_cfg80211.c b/drivers/net/wireless/rdaw80211/rdawlan/wland_cfg80211.c
index 4eecc1e..0776cda 100644
--- a/drivers/net/wireless/rdaw80211/rdawlan/wland_cfg80211.c
+++ b/drivers/net/wireless/rdaw80211/rdawlan/wland_cfg80211.c
@@ -1262,13 +1262,20 @@ static s32 wland_cfg80211_connect(struct wiphy *wiphy, struct net_device *ndev,
 	cfg->in_waiting = false;
 
 	memset(profile, '\0', sizeof(struct wland_cfg80211_profile));
-	memcpy(profile->bssid, sme->bssid, ETH_ALEN);
-	profile->valid_bssid = true;
+	/*
+	 * cfg80211 passes no BSSID and no channel when userspace names only
+	 * the SSID (iw connect, an open network); both were dereferenced
+	 * here, under the RTNL and wiphy locks, which then stayed held.
+	 */
+	if (sme->bssid) {
+		memcpy(profile->bssid, sme->bssid, ETH_ALEN);
+		profile->valid_bssid = true;
+	}
 
 	WLAND_DBG(CFG80211, TRACE,
-		"sme->ssid:%s, sme->bssid:%pM, sme->channel:%d\n", sme->ssid,
-		sme->bssid,
-		ieee80211_frequency_to_channel(sme->channel->center_freq));
+		"sme->ssid:%.*s, sme->bssid:%pM, sme->channel:%d\n",
+		(int)sme->ssid_len, sme->ssid, sme->bssid,
+		sme->channel ? ieee80211_frequency_to_channel(sme->channel->center_freq) : 0);
 	WLAND_DBG(CFG80211, TRACE,
 		"sme->auth_type:%d, sme->ie_len:%d, sme->key_len:%d\n",
 		sme->auth_type, sme->ie_len, sme->key_len);
@@ -2827,7 +2834,19 @@ static bool compare_update_same_bss(struct wland_cfg80211_info *cfg,
 	return false;
 }
 
-void ParseNetworkInfo(struct wland_bss_info_le *bi, u8 * pu8MsgBuffer)
+/* Bytes of a scan result ahead of its information elements. */
+#define WLAND_SCAN_FIXED_LEN \
+	(MAC_HDR_LEN + TIME_STAMP_LEN + BEACON_INTERVAL_LEN + CAP_INFO_LEN)
+
+/*
+ * Parse a scan result ('N' message) of datalen bytes. Returns 0, or
+ * -EINVAL for a frame its own lengths do not fit: they come from the
+ * firmware, and a WidLen of 0 made MsaLen wrap to 65535, so the IE copy
+ * read about 64 KB past a 2 KB event and handed that heap memory to
+ * userspace as the AP's IEs.
+ */
+static int ParseNetworkInfo(struct wland_bss_info_le *bi, u8 * pu8MsgBuffer,
+	u32 datalen)
 {
 	u8 u8MsgType = 0, u8MsgID = 0, u8index = 0;
 	u16 u16MsgLen = 0, u16WidID = 0, u16WidLen = 0, u16MsaLen;
@@ -2838,9 +2857,9 @@ void ParseNetworkInfo(struct wland_bss_info_le *bi, u8 * pu8MsgBuffer)
 	/*
 	 * Check whether the received message type is 'N'
 	 */
-	if (('N' != u8MsgType) || (!bi)) {
+	if (datalen < 9 || ('N' != u8MsgType) || (!bi)) {
 		WLAND_ERR("Received Message format incorrect.\n");
-		return;
+		return -EINVAL;
 	}
 
 	/*
@@ -2863,6 +2882,13 @@ void ParseNetworkInfo(struct wland_bss_info_le *bi, u8 * pu8MsgBuffer)
 	 */
 	u16WidLen = MAKE_WORD16(pu8MsgBuffer[6], pu8MsgBuffer[7]);
 
+	/* The value is the RSSI byte and the frame, within the message. */
+	if (u16WidLen < 1 + WLAND_SCAN_FIXED_LEN || 8 + (u32)u16WidLen > datalen) {
+		WLAND_ERR("Scan result of %u bytes cannot hold a %u byte frame\n",
+			datalen, u16WidLen);
+		return -EINVAL;
+	}
+
 	WLAND_DBG(CFG80211, TRACE,
 		"u8MsgID:%d, u16MsgLen:%d, u16WidID:0x%04x, u16WidLen:%d\n",
 		u8MsgID, u16MsgLen, u16WidID, u16WidLen);
@@ -2948,14 +2974,14 @@ void ParseNetworkInfo(struct wland_bss_info_le *bi, u8 * pu8MsgBuffer)
 	bi->ie = kmalloc(bi->ie_length, GFP_KERNEL);
 	if (!(bi->ie)) {
 		WLAND_ERR("failed to allocate memory\n");
-		return;
+		return -ENOMEM;
 	}
 	memcpy(bi->ie, &pu8WidVal[MAC_HDR_LEN + TIME_STAMP_LEN + BEACON_INTERVAL_LEN + CAP_INFO_LEN], bi->ie_length);
 
 	WLAND_DBG(CFG80211, TRACE,
 		"bi->SSID(%s), bi->ie_length:%d, bi->ie:%p, bi->length:%d\n",
 		bi->SSID, bi->ie_length, bi->ie, bi->length);
-
+	return 0;
 }
 
 static s32 notify_escan_handler(struct wland_if *ifp,
@@ -2978,7 +3004,8 @@ static s32 notify_escan_handler(struct wland_if *ifp,
 			goto exit;
 		}
 		memset(&bss_info_le, '\0', sizeof(struct wland_bss_info_le));
-		ParseNetworkInfo(&bss_info_le, (u8 *) data);
+		if (ParseNetworkInfo(&bss_info_le, (u8 *) data, e->datalen))
+			goto exit;
 		if (bss_info_le.ctl_ch == 0) {
 			WLAND_ERR("failed to get bss channel number\n");
 			goto exit;
diff --git a/drivers/net/wireless/rdaw80211/rdawlan/wland_cmds.c b/drivers/net/wireless/rdaw80211/rdawlan/wland_cmds.c
index 4f64777..7393016 100644
--- a/drivers/net/wireless/rdaw80211/rdawlan/wland_cmds.c
+++ b/drivers/net/wireless/rdaw80211/rdawlan/wland_cmds.c
@@ -1383,6 +1383,13 @@ s32 wland_fil_set_mgmt_ie(struct wland_if * ifp, u8 * vndr_ie_buf,
 	s32 ret = 0;
 	struct wland_private *drvr = ifp->drvr;
 
+	/*
+	 * Only the first IE is sent. Its own length byte decides how much,
+	 * and it must fit what the caller has: a connect with no IEs passed
+	 * a NULL buffer, which was read here.
+	 */
+	if (!vndr_ie_buf || vndr_ie_len < 2 || vndr_ie_buf[1] + 2 > vndr_ie_len)
+		return 0;
 	vndr_ie_len = vndr_ie_buf[1] + 2;
 	WLAND_DBG(DCMD, TRACE,"Enter vndr_ie_len=%d, vndr_ie_buf=%p\n", vndr_ie_len, vndr_ie_buf);
 	WLAND_DUMP(TX_CTRL, vndr_ie_buf, vndr_ie_len, "mgmt_le_len:%Zu\n", vndr_ie_len);
diff --git a/drivers/net/wireless/rdaw80211/rdawlan/wland_sdio.c b/drivers/net/wireless/rdaw80211/rdawlan/wland_sdio.c
index 8e15bda..043ad9c 100644
--- a/drivers/net/wireless/rdaw80211/rdawlan/wland_sdio.c
+++ b/drivers/net/wireless/rdaw80211/rdawlan/wland_sdio.c
@@ -774,6 +774,17 @@ static int wland_sdio_process_rxframes(struct wland_sdio *bus)
 		//skb->len = rx_len;
 
 		if (rx_type == PKT_TYPE_CFG_RSP) {
+			/*
+			 * The frame carries the 2-byte header and the message type
+			 * at least. A shorter one (a corrupted SDIO read) made
+			 * datalen = rx_len - WID_HEADER_LEN wrap to ~4 GB on this
+			 * u32, and the event copy that follows overran the heap.
+			 */
+			if (rx_len < WID_HEADER_LEN + 1) {
+				WLAND_ERR("short config frame (%u bytes), dropped\n", rx_len);
+				wland_pkt_buf_free_skb(skb);
+				continue;
+			}
 			msg_type = buf[2];
 
 			memset(&event_packet, 0, sizeof(event_packet));
@@ -793,6 +804,17 @@ static int wland_sdio_process_rxframes(struct wland_sdio *bus)
 					skb->len, rx_len, rx_type);
 				WLAND_DUMP(RX_WIDRSP, skb->data, skb->len,
 					"RX Data (WID_MSG_RESP), len:%Zu\n", skb->len);
+				/*
+				 * rxbuf holds maxctl + 4 bytes, less than the
+				 * largest frame the SDIO read accepts: a long
+				 * response used to overrun it.
+				 */
+				if (rx_len > bus->rxblen) {
+					WLAND_ERR("WID response of %u bytes does not fit %u, dropped\n",
+						rx_len, bus->rxblen);
+					wland_pkt_buf_free_skb(skb);
+					break;
+				}
 				spin_lock_bh(&bus->rxctl_lock);
 				bus->rxctl = bus->rxbuf;
 				bus->rxlen = rx_len;
