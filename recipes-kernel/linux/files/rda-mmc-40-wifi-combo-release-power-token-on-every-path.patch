 	return ret;
 }
 
-int rda_5991_wifi_power_on(void)
+static int __rda_5991_wifi_power_on(void)
 {
 	int ret = 0, bt_power_on = 0;
 
-	//if bt is power on wait until it's complete
-	wait_for_completion(&rda_wifi_bt_comp);
-
 	rda_combo_i2c_lock();
 	enable_26m_regulator(CLOCK_WLAN);
 	enable_32k_rtc(CLOCK_WLAN);
@@ -435,7 +432,6 @@ int rda_5991_wifi_power_on(void)
 	rda_combo_i2c_unlock();
 	msleep(100);
 	disable_26m_rtc(CLOCK_WLAN);
-	complete(&rda_wifi_bt_comp);
 #ifdef RDA_COMBO_FROM_FIRMWARE
 	atomic_set(&wifi_fw_status, 1);
 #endif
@@ -451,6 +447,20 @@ err:
 	return -1;
 }
 
+/* One power sequence at a time. The token is given back on every path:
+ * a power-on that failed used to keep it, and every later power-on then
+ * blocked for good (at boot, since the combo is powered from client probe).
+ */
+int rda_5991_wifi_power_on(void)
+{
+	int ret;
+
+	wait_for_completion(&rda_wifi_bt_comp);
+	ret = __rda_5991_wifi_power_on();
+	complete(&rda_wifi_bt_comp);
+	return ret;
+}
+
 int rda_5991_wifi_power_off(void)
 {
 	int ret = 0;
@@ -493,13 +503,10 @@ int rda_5991_wifi_power_off(void)
