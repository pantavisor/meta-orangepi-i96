@@ -208,9 +208,11 @@ int osl_get_image_block(char *buf, int len, void *image)
 	if (!image)
 		return 0;
 
-	rdlen = kernel_read(fp, fp->f_pos, buf, len);
-	if (rdlen > 0)
-		fp->f_pos += rdlen;
+	/*
+	 * kernel_read() changed signature in 4.14: it now takes the buffer
+	 * before the length and the position by pointer, which it advances.
