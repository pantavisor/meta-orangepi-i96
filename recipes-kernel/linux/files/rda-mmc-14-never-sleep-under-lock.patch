-		goto done_irqunlock;
+		goto done;
 	}
 
 	/* Interrupt will pick up on this */
 	if (!data)
-		goto done_irqunlock;
-
-	spin_unlock_irqrestore(&priv->lock, flags);
+		goto done;
 
